@* Menu lateral fixo da área do restaurante (só funcionário) *@
@using System.Security.Claims
@{
    // Só mostra para cookie/claims de funcionário
    var ehFuncionario = User?.HasClaim(ClaimTypes.Role, "Funcionario") == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool Ativo(string c, string? a = null) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase)
        && (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));

    // Reservas: Index Reservas do painel + Edit/Details via AreaRestaurante
    var reservasAtivo = Ativo("AreaRestaurante") && !Ativo("AreaRestaurante", "Index");
    var inicioAtivo = Ativo("AreaRestaurante", "Index");
}
@if (ehFuncionario)
{
    <button type="button"
            class="menu-restaurante-toggle"
            id="menuRestauranteToggle"
            aria-label="Abrir ou fechar menu"
            aria-controls="menuRestaurante"
            aria-expanded="false">☰</button>

    <aside class="menu-restaurante" id="menuRestaurante" aria-label="Menu da área do restaurante">
        <a class="menu-restaurante-brand"
           asp-controller="AreaRestaurante"
           asp-action="Index">
            <img src="~/images/logosantamassa.jpg" alt="Logo Santa Massa" />
            <span>Área do Restaurante</span>
        </a>

        <nav class="menu-restaurante-nav">
            <a class="menu-restaurante-link @(inicioAtivo ? "menu-restaurante-link--ativo" : null)"
               asp-controller="AreaRestaurante" asp-action="Index">Início</a>
            <a class="menu-restaurante-link @(reservasAtivo ? "menu-restaurante-link--ativo" : null)"
               asp-controller="AreaRestaurante" asp-action="Reservas">Reservas</a>
            <a class="menu-restaurante-link @(Ativo("Mesa") ? "menu-restaurante-link--ativo" : null)"
               asp-controller="Mesa" asp-action="Index">Mesas</a>
            <a class="menu-restaurante-link @(Ativo("Ambiente") ? "menu-restaurante-link--ativo" : null)"
               asp-controller="Ambiente" asp-action="Index">Ambientes</a>
            <a class="menu-restaurante-link @(Ativo("Cliente") ? "menu-restaurante-link--ativo" : null)"
               asp-controller="Cliente" asp-action="Index">Clientes</a>
            <a class="menu-restaurante-link @(Ativo("Funcionario") ? "menu-restaurante-link--ativo" : null)"
               asp-controller="Funcionario" asp-action="Index">Funcionários</a>
        </nav>

        <div class="menu-restaurante-rodape">
            @* Mesmo Logout do header ([IgnoreAntiforgeryToken] no AuthController) *@
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-restaurante-sair">Sair</button>
            </form>
        </div>
    </aside>

    <script>
        (function () {
            var btn = document.getElementById('menuRestauranteToggle');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var aberto = document.body.classList.toggle('menu-restaurante-aberto');
                btn.setAttribute('aria-expanded', aberto ? 'true' : 'false');
            });
        })();
    </script>
}
