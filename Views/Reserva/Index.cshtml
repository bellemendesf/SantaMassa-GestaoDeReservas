
@* Importação usada pelas views *@
@using GestaoReservas.Models
@* Tipo de dado (modelo) que esta view recebe do controller *@
@model IEnumerable<Reserva>

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    // Atribui Layout
    bool restauranteLayout = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "AreaRestaurante",
        StringComparison.OrdinalIgnoreCase);
    // Cliente: layout sem sidebar; Restaurante: layout com menu lateral
    Layout = restauranteLayout
        ? "~/Views/Shared/_RestauranteLayout.cshtml"
        : "~/Views/Shared/_ReservaLayout.cshtml";
    // Título e subtítulo por perfil (só apresentação; não altera regras de negócio)
    ViewData["Title"] = restauranteLayout ? "Reservas" : (ViewData["Title"] ?? "Minhas reservas");
    ViewData["Lead"] = restauranteLayout
        ? "Acompanhe e organize as reservas do restaurante."
        : "Suas reservas em um só lugar: visualize, altere ou cancele.";

    // Variável lista
    var lista = Model?.ToList() ?? new List<Reserva>();

    // Variável restaurante
    bool restaurante = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "AreaRestaurante",
        StringComparison.OrdinalIgnoreCase);

    // Filtro ativo do cliente (próximas | historico)
    var filtroCliente = (ViewBag.FiltroReservas as string) ?? "proximas";
    // Valores do formulário de filtro do restaurante
    var filtroNome = ViewBag.FiltroNome as string ?? "";
    var filtroStatus = ViewBag.FiltroStatus as string ?? "Todos";
}

@* Seção da página *@
<section class="reservas-lista">

    @* Cabeçalho *@
    <header class="reservas-lista-cabecalho">
        @* Bloco *@
        <div>
            @* Parágrafo de texto *@
            <p class="reservas-lista-kicker">@(restaurante ? "PAINEL DE CONTROLE" : "ÁREA DO CLIENTE")</p>
            @* Subtítulo *@
            <h2>@(restaurante ? "Reservas cadastradas" : "Minhas reservas")</h2>
            @* Parágrafo de texto *@
            <p class="reservas-lista-descricao">
                @(restaurante
                    ? "Acompanhe os agendamentos e gerencie as reservas do restaurante."
                    : "Use Detalhes, Editar ou Cancelar em cada linha da tabela.")
            </p>
        </div>

        @* Texto destacado *@
        <span class="reservas-contador">
            @lista.Count @(lista.Count == 1 ? "reserva" : "reservas")
        </span>
    </header>

    @if (TempData["AvisoJuncaoMesas"] is string avisoJuncao && !string.IsNullOrWhiteSpace(avisoJuncao))
    {
        <p class="reservas-alerta-sucesso">@avisoJuncao</p>
    }

    @* Filtros do cliente: Próximas / Histórico *@
    @if (!restaurante)
    {
        <div class="reservas-filtros" role="group" aria-label="Filtro de reservas">
            <a asp-controller="Reserva"
               asp-action="Index"
               asp-route-filtro="proximas"
               class="reservas-filtro-btn @(filtroCliente == "proximas" ? "reservas-filtro-btn--ativo" : null)">
                Próximas
            </a>
            <a asp-controller="Reserva"
               asp-action="Index"
               asp-route-filtro="historico"
               class="reservas-filtro-btn @(filtroCliente == "historico" ? "reservas-filtro-btn--ativo" : null)">
                Histórico
            </a>
            <a asp-controller="Reserva"
               asp-action="Create"
               class="reservas-botao-novo">
                + Nova reserva
            </a>
        </div>
    }

    @* Filtros do restaurante: card alinhado à listagem *@
    @if (restaurante)
    {
        <div class="reservas-filtro-card">
            <form method="get"
                  asp-controller="AreaRestaurante"
                  asp-action="Reservas"
                  class="reservas-filtro-form"
                  role="search">
                <div class="reservas-filtro-campo reservas-filtro-campo--nome">
                    <label for="nome">Nome do cliente</label>
                    <input id="nome"
                           name="nome"
                           type="search"
                           value="@filtroNome"
                           placeholder="Buscar por nome do cliente"
                           autocomplete="off" />
                </div>
                <div class="reservas-filtro-campo reservas-filtro-campo--status">
                    <label for="status">Status</label>
                    <select id="status" name="status">
                    @if (filtroStatus == "Todos")
                    { <option value="Todos" selected>Todos</option> }
                    else
                    { <option value="Todos">Todos</option> }
                    @if (filtroStatus == "Pendente")
                    { <option value="Pendente" selected>Pendente</option> }
                    else
                    { <option value="Pendente">Pendente</option> }
                    @if (filtroStatus == "Confirmada")
                    { <option value="Confirmada" selected>Confirmada</option> }
                    else
                    { <option value="Confirmada">Confirmada</option> }
                    @if (filtroStatus == "Cancelada")
                    { <option value="Cancelada" selected>Cancelada</option> }
                    else
                    { <option value="Cancelada">Cancelada</option> }
                    </select>
                </div>
                <div class="reservas-filtro-acoes">
                    <button type="submit" class="reservas-filtro-btn reservas-filtro-btn--primario">Filtrar</button>
                    <a asp-controller="AreaRestaurante" asp-action="Reservas" class="reservas-filtro-btn reservas-filtro-btn--secundario">Limpar</a>
                </div>
            </form>
            <p class="reservas-filtro-resultado">
                @lista.Count @(lista.Count == 1 ? "resultado" : "resultados")
            </p>
        </div>
    }

    @* Lista vazia *@
    @if (!lista.Any())
    {
        <div class="reservas-vazio">
            <div class="reservas-vazio-icone">R</div>
            <h3>
                @if (restaurante)
                {
                    @:Nenhuma reserva encontrada
                }
                else if (filtroCliente == "historico")
                {
                    @:Nenhuma reserva no histórico
                }
                else
                {
                    @:Nenhuma reserva próxima
                }
            </h3>
            <p>
                @if (restaurante)
                {
                    @:Nenhum resultado para os filtros escolhidos. Ajuste a busca ou limpe os filtros.
                }
                else if (filtroCliente == "historico")
                {
                    @:Você ainda não tem reservas passadas neste histórico.
                }
                else
                {
                    @:Você não possui reservas futuras. Que tal planejar sua próxima visita?
                }
            </p>
            @if (!restaurante && filtroCliente == "proximas")
            {
                <a asp-controller="Reserva" asp-action="Create" class="reservas-botao-novo">+ Nova reserva</a>
            }
        </div>
    }
    else
    {
        <div class="reservas-tabela-wrap">
            <table class="reservas-tabela">
                <thead>
                    <tr>
                        @if (restaurante)
                        {
                            <th>Cliente</th>
                        }
                        <th>Mesas</th>
                        <th>Data e horário</th>
                        <th>Pessoas</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reserva in lista)
                    {
                        var status = reserva.Status ?? "";
                        var badge = status.ToLowerInvariant() switch
                        {
                            "confirmada" => "status-confirmada",
                            "realizada" => "status-confirmada",
                            "pendente" => "status-pendente",
                            "cancelada" => "status-cancelada",
                            _ => "status-outro"
                        };
                        <tr class="@(restaurante && string.Equals(status, "Pendente", StringComparison.OrdinalIgnoreCase) ? "reserva-linha-pendente" : null)">
                            @if (restaurante)
                            {
                                <td data-label="Cliente" class="reserva-cliente">
                                    @(reserva.Cliente?.Nome ?? "—")
                                </td>
                            }
                            <td data-label="Mesa">
                                @foreach (var mesa in reserva.MesasDescricao)
                                {
                                    <div>@mesa</div>
                                }
                            </td>
                            <td data-label="Data e horário" class="reserva-data">
                                @HorarioFuncionamento.Formatar(reserva.DataHora)
                            </td>
                            <td data-label="Pessoas">
                                @reserva.QtdPessoas
                            </td>
                            <td data-label="Status">
                                <span class="reserva-status @badge">
                                    @(string.IsNullOrWhiteSpace(status) ? "Não informado" : status)
                                </span>
                            </td>
                            <td data-label="Ações">
                                <div class="reservas-acoes">
                                    <a asp-action="Details" asp-route-id="@reserva.Id" class="reserva-acao">
                                        @(restaurante ? "Detalhes" : "Visualizar")
                                    </a>
                                    @if (!string.Equals(status, "Cancelada", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-action="Edit" asp-route-id="@reserva.Id" class="reserva-acao">
                                            @(restaurante ? "Alterar status" : "Editar")
                                        </a>
                                    }
                                    @if (!restaurante &&
                                         !string.Equals(status, "Cancelada", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-action="Delete" asp-route-id="@reserva.Id" class="reserva-acao reserva-acao-cancelar">
                                            Cancelar
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <footer class="reservas-lista-rodape">
        Santa Massa - Gestão de reservas
    </footer>

</section>
