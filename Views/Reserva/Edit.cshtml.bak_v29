@* Tipo de dado (modelo) que esta view recebe do controller *@
@model GestaoReservas.Models.Reserva

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    ViewData["Title"] = "Editar Reserva";
    // Atribui Layout
    Layout = null;
    // Variável restaurante
    bool restaurante = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "AreaRestaurante", StringComparison.OrdinalIgnoreCase);
    // Variável voltar
    string voltar = restaurante ? "Reservas" : "Index";
    // Se a reserva já é de data passada, o min fica nessa data para o input date não ficar inválido no navegador.
    // O servidor ainda bloqueia trocar para OUTRA data passada.
    var dataMinimaReserva = (Model.DataHora != default && Model.DataHora.Date < DateTime.Today)
        ? Model.DataHora.ToString("yyyy-MM-dd")
        : DateTime.Today.ToString("yyyy-MM-dd");
    var dataMaximaReserva = DateTime.Today.AddDays(90).ToString("yyyy-MM-dd");
}

@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>@ViewData["Title"]</title>

    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/DetalhesEdicao.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/TemaClaro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MenuRestaurante.css" asp-append-version="true" />
</head>
@* Corpo da página *@
<body class="detalhes-edicao-page tema-claro com-sidebar-restaurante">
@await Html.PartialAsync("_MenuRestaurante")

    @* Conteúdo principal *@
    <main class="detalhes-edicao-container">
        @* Link (asp-action @voltar) *@
        <a asp-action="@voltar" class="detalhes-edicao-voltar">← Voltar às reservas</a>

        @* Seção da página *@
        <section class="detalhes-edicao-card">
            @* Cabeçalho *@
            <header class="detalhes-edicao-header">
                @* Parágrafo de texto *@
                <p class="detalhes-edicao-kicker">Santa Massa · Rio Preto</p>
                @* Título principal *@
                <h1>Editar reserva</h1>
                @* Parágrafo de texto *@
                <p class="detalhes-edicao-descricao">
                    @(restaurante
                        ? "Altere o status da reserva."
                        : "Altere o dia ou aumente a quantidade de pessoas. Não é possível diminuir a quantidade; se precisar de menos lugares, cancele e faça uma nova reserva. Se aumentar e faltar lugar, o sistema junta mesas livres do mesmo ambiente.")
                </p>
            </header>

            @* Bloco (classe detalhes-edicao-conteudo) *@
            <div class="detalhes-edicao-conteudo">
                @* Formulário (asp-action Edit, id @Model.Id) *@
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="detalhes-edicao-form">
                    @* Campo de entrada (asp-for Id) *@
                    <input type="hidden" asp-for="Id" />
                    @* N:N: as mesas não são enviadas; o servidor mantém as mesas originais da reserva. *@

                    @* Resumo dos erros de validação *@
                    <div asp-validation-summary="All" class="detalhes-edicao-erros detalhes-edicao-alerta-erro"></div>

                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* Rótulo do campo *@
                        <label>Mesas</label>
                        @* N:N: mostra todas as mesas da reserva *@
                        <input type="text" value="@string.Join(", ", Model.MesasDescricao)" readonly />
                        @* Texto de ajuda *@
                        <small class="detalhes-edicao-ajuda">
                            Você não troca as mesas manualmente; se faltar capacidade, o sistema junta mesas livres.
                        </small>
                    </div>

                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* RESERVA POR DIA: apenas o dia é editável, sem horário. *@
                        <label asp-for="DataHora">Data</label>
                        @* Campo de entrada (asp-for DataHora) *@
                        <input asp-for="DataHora" type="date" min="@dataMinimaReserva" max="@dataMaximaReserva" readonly="@restaurante" />
                        @* Texto destacado *@
                        <span asp-validation-for="DataHora" class="detalhes-edicao-erros"></span>
                    </div>

                    @* Bloco (classe detalhes-edicao-campo) *@
                    <div class="detalhes-edicao-campo">
                        @* Rótulo do campo (asp-for QtdPessoas) *@
                        <label asp-for="QtdPessoas">Quantidade de pessoas</label>
                        @* Cliente: min = quantidade atual (não pode diminuir). Restaurante: campo só leitura. *@
                        <input asp-for="QtdPessoas" type="number"
                               min="@(restaurante ? 1 : Model.QtdPessoas)"
                               max="30"
                               readonly="@restaurante" />
                        @if (!restaurante)
                        {
                            <small class="detalhes-edicao-ajuda">
                                Mínimo permitido: @Model.QtdPessoas pessoa(s). Só é possível aumentar.
                            </small>
                            <p class="detalhes-edicao-alerta-aviso" style="margin-top:10px;">
                                Não é possível diminuir a quantidade de pessoas nesta reserva.
                            </p>
                        }
                        @* Texto destacado *@
                        <span asp-validation-for="QtdPessoas" class="detalhes-edicao-erros"></span>
                    </div>


@* CORREÇÃO: o status só aparece para o restaurante; o cliente altera apenas dia e quantidade. *@
@if (restaurante)
{
<div class="detalhes-edicao-campo">
    @* Rótulo do campo (asp-for Status) *@
    <label asp-for="Status">Status da reserva</label>

    @* Lista de seleção (asp-for Status) *@
    <select asp-for="Status">
        @* Opção da lista *@
        <option value="Pendente">Pendente</option>
        @* Opção da lista *@
        <option value="Confirmada">Confirmada</option>
        @* Opção da lista *@
        <option value="Cancelada">Cancelada</option>
    </select>

    @* Texto destacado *@
    <span asp-validation-for="Status" class="detalhes-edicao-erros"></span>
</div>
}


                    @* Bloco (classe detalhes-edicao-acoes) *@
                    <div class="detalhes-edicao-acoes">
                        @* Botão *@
                        <button type="submit"
                                class="detalhes-edicao-botao detalhes-edicao-botao-principal">
                            Salvar alterações
                        </button>

                        @* Link (asp-action @voltar) *@
                        <a asp-action="@voltar"
                           class="detalhes-edicao-botao detalhes-edicao-botao-secundario">
                            Cancelar
                        </a>

                        @* CORREÇÃO: o cliente pode cancelar a reserva pela confirmação já existente (Reserva/Delete). *@
                        @if (!restaurante)
                        {
                            @* Leva à tela de confirmação, que muda o status para Cancelada *@
                            <a asp-action="Delete" asp-route-id="@Model.Id"
                               class="detalhes-edicao-botao detalhes-edicao-botao-secundario">
                                Cancelar reserva
                            </a>
                        }
                    </div>
                </form>
            </div>

            @* Rodapé *@
            <footer class="detalhes-edicao-rodape">
                Santa Massa · Painel de gerenciamento
            </footer>
        </section>
    </main>
@if (!restaurante)
{
<script>
    (function () {
        const campo = document.getElementById("DataHora");
        if (!campo) return;
        const aviso = document.createElement("p");
        aviso.className = "detalhes-edicao-alerta-aviso";
        aviso.hidden = true;
        campo.parentElement.appendChild(aviso);
        function checar() {
            if (!campo.value) { aviso.hidden = true; return; }
            const p = campo.value.split("-");
            const d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
            if (d.getDay() === 0) {
                aviso.hidden = false;
                aviso.textContent = "O restaurante não funciona aos domingos. Escolha um dia de segunda a sábado.";
            } else {
                aviso.hidden = true;
                aviso.textContent = "";
            }
        }
        campo.addEventListener("change", checar);
        campo.addEventListener("input", checar);
    })();
</script>
}
</body>
</html>