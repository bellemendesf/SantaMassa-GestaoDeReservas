@* Tipo de dado (modelo) que esta view recebe do controller *@
@model Cliente
@* View Edit de Cliente: apresenta os campos do DER via model MVC.
   As alterações passam pelo controller e pela interface do repositório. *@
@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>Edit - Cliente</title>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/TemaClaro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MenuRestaurante.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ValidacaoFormularios.css" asp-append-version="true" />
</head>
@* Corpo da página *@
<body class="container py-4 tema-claro com-sidebar-restaurante">
@await Html.PartialAsync("_MenuRestaurante")

    @* Navegação *@
    <nav class="mb-4">
        @* Link *@
        <a href="/Cliente/Index">Clientes</a> |
        @* Link *@
        <a href="/Funcionario/Index">Funcionários</a>
    </nav>
    @* Título principal *@
    <h1>Editar Cliente</h1>
    @* Resumo dos erros de validação *@
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @* Formulário *@
    <form action="/Cliente/Edit/@Model.Id" method="POST" novalidate data-validacao-form>
        @* Token antifalsificação do formulário *@
        @Html.AntiForgeryToken()
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="Nome" class="form-label">Nome</label>
            @* Campo de entrada (id Nome) *@
            <input id="Nome" name="Nome" type="text" value="@Model.Nome" class="form-control" maxlength="50" data-valida="nome" title="Informe o nome com pelo menos 3 letras, sem números ou símbolos." required>
            <span id="Nome-erro" class="erro-campo" data-erro-para="Nome" hidden></span>
        </div>
        @* CPF fica oculto para o funcionário não ver. *@
        @* O valor segue no POST, porque o campo é obrigatório no salvamento. *@
        <input type="hidden" id="Cpf" name="Cpf" value="@Model.Cpf" />
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="EmailPessoal" class="form-label">E-mail pessoal</label>
            @* Campo de entrada (id EmailPessoal) *@
            <input id="EmailPessoal" name="EmailPessoal" type="email" value="@Model.EmailPessoal" class="form-control" data-valida="email" title="Informe um e-mail válido (ex.: nome@email.com)." required>
            <span id="EmailPessoal-erro" class="erro-campo" data-erro-para="EmailPessoal" hidden></span>
        </div>
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="Telefone" class="form-label">Telefone</label>
            @* Campo de entrada (id Telefone) *@
            <input id="Telefone" name="Telefone" type="tel" value="@Model.Telefone" class="form-control" inputmode="numeric" maxlength="15" data-valida="telefone" title="Informe um telefone com 10 ou 11 dígitos (DDD)." required>
            <span id="Telefone-erro" class="erro-campo" data-erro-para="Telefone" hidden></span>
        </div>
        @* Nunca preenchemos a senha com o valor armazenado pelo controller. *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="Senha" class="form-label">Senha (deixe em branco para manter a atual)</label>
            @* Campo de entrada (id Senha) *@
            <input id="Senha" name="Senha" type="password" autocomplete="new-password" class="form-control" >
        </div>
        @* Botão *@
        <button type="submit" class="btn btn-primary">Salvar</button>
        @* Link *@
        <a href="/Cliente/Index" class="btn btn-secondary">Voltar</a>
    </form>
    <script src="~/js/validacaoFormularios.js" asp-append-version="true"></script>
</body>
</html>