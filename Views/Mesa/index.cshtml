@using GestaoReservas.Models
@model List<GestaoReservas.Models.Mesa>

@* Painel de gerenciamento das mesas na área do restaurante. *@
@{
    // Esta tela não usa o layout compartilhado (mantém o padrão atual).
    Layout = null;
    ViewData["Title"] = "Mesas";

    // Lista segura mesmo se o modelo vier nulo.
    var mesas = Model ?? new List<Mesa>();
    // Totais do cabeçalho (só status que existem no cadastro).
    var totalMesas = mesas.Count;
    var livres = mesas.Count(m => string.Equals(m.Status?.Trim(), "Livre", StringComparison.OrdinalIgnoreCase));
    var ocupadas = mesas.Count(m => string.Equals(m.Status?.Trim(), "Ocupada", StringComparison.OrdinalIgnoreCase));
    var reservadas = mesas.Count(m => string.Equals(m.Status?.Trim(), "Reservada", StringComparison.OrdinalIgnoreCase));
    // Outros status (ex.: Indisponível), se existirem no banco.
    var outrosStatus = mesas
        .Select(m => (m.Status ?? "").Trim())
        .Where(s => s.Length > 0
            && !s.Equals("Livre", StringComparison.OrdinalIgnoreCase)
            && !s.Equals("Ocupada", StringComparison.OrdinalIgnoreCase)
            && !s.Equals("Reservada", StringComparison.OrdinalIgnoreCase))
        .GroupBy(s => s, StringComparer.OrdinalIgnoreCase)
        .Select(g => new { Nome = g.First(), Quantidade = g.Count() })
        .OrderBy(g => g.Nome)
        .ToList();
    // Soma da capacidade de todas as mesas cadastradas.
    var capacidadeTotal = mesas.Sum(m => m.QtdLugares);
    // Ambientes distintos para o filtro (só front-end).
    var ambientes = mesas
        .Select(m => (m.AmbienteNome ?? "").Trim())
        .Where(n => n.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n)
        .ToList();
    // Status distintos para o filtro.
    var listaStatus = mesas
        .Select(m => (m.Status ?? "").Trim())
        .Where(s => s.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s)
        .ToList();
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/Mesas.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/Listagens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Reserva.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TemaClaro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MenuRestaurante.css" asp-append-version="true" />
</head>

<body class="mesas-page has-fixed-page-top tema-claro com-sidebar-restaurante">
@await Html.PartialAsync("_MenuRestaurante")
@await Component.InvokeAsync("ReservaPageTop")

    <main class="mesas-container">
        <section class="mesas-card">
            <header class="mesas-header">
                <div>
                    <p class="mesas-kicker">Santa Massa - Rio Preto</p>
                    <h1>Painel de mesas</h1>
                    <p class="mesas-descricao">
                        Acompanhe o status, o ambiente e a capacidade de cada mesa.
                    </p>
                </div>

                <a asp-controller="Mesa" asp-action="Create" class="btn-mesa-nova">
                    + Nova mesa
                </a>
            </header>

            <div class="mesas-conteudo">
                @if (totalMesas == 0)
                {
                    <div class="mesas-vazio">
                        <h2>Nenhuma mesa cadastrada</h2>
                        <p>Cadastre uma mesa para começar a organizar o restaurante.</p>
                        <a asp-controller="Mesa" asp-action="Create" class="btn-mesa-nova">
                            Cadastrar primeira mesa
                        </a>
                    </div>
                }
                else
                {
                    @* Resumo do acervo: totais por status existentes e capacidade. *@
                    <div class="mesas-resumo" aria-label="Resumo das mesas">
                        <article class="mesas-resumo-item">
                            <span class="mesas-resumo-rotulo">Total de mesas</span>
                            <strong class="mesas-resumo-valor">@totalMesas</strong>
                        </article>
                        @if (livres > 0)
                        {
                            <article class="mesas-resumo-item mesas-resumo-livre">
                                <span class="mesas-resumo-rotulo">Livres</span>
                                <strong class="mesas-resumo-valor">@livres</strong>
                            </article>
                        }
                        @if (reservadas > 0)
                        {
                            <article class="mesas-resumo-item mesas-resumo-reservada">
                                <span class="mesas-resumo-rotulo">Reservadas</span>
                                <strong class="mesas-resumo-valor">@reservadas</strong>
                            </article>
                        }
                        @if (ocupadas > 0)
                        {
                            <article class="mesas-resumo-item mesas-resumo-ocupada">
                                <span class="mesas-resumo-rotulo">Ocupadas</span>
                                <strong class="mesas-resumo-valor">@ocupadas</strong>
                            </article>
                        }
                        @foreach (var outro in outrosStatus)
                        {
                            <article class="mesas-resumo-item mesas-resumo-outro">
                                <span class="mesas-resumo-rotulo">@outro.Nome</span>
                                <strong class="mesas-resumo-valor">@outro.Quantidade</strong>
                            </article>
                        }
                        <article class="mesas-resumo-item mesas-resumo-capacidade">
                            <span class="mesas-resumo-rotulo">Capacidade total</span>
                            <strong class="mesas-resumo-valor">@capacidadeTotal</strong>
                            <span class="mesas-resumo-ajuda">@(capacidadeTotal == 1 ? "lugar" : "lugares")</span>
                        </article>
                    </div>

                    @* Filtros só no navegador: não mudam rota nem consulta. Ambiente e status ficam no sessionStorage e voltam ao reabrir a listagem. *@
                    <div class="mesas-filtros">
                        <label class="mesas-filtro">
                            <span>Ambiente</span>
                            <select id="filtro-ambiente" aria-label="Filtrar por ambiente">
                                <option value="">Todos os ambientes</option>
                                @foreach (var ambiente in ambientes)
                                {
                                    <option value="@ambiente">@ambiente</option>
                                }
                            </select>
                        </label>
                        <label class="mesas-filtro">
                            <span>Status</span>
                            <select id="filtro-status" aria-label="Filtrar por status">
                                <option value="">Todos os status</option>
                                @foreach (var statusFiltro in listaStatus)
                                {
                                    <option value="@statusFiltro">@statusFiltro</option>
                                }
                            </select>
                        </label>
                    </div>

                    @* Cada mesa em um cartão, com os mesmos dados da listagem anterior. *@
                    <div class="mesas-grade" id="mesas-grade">
                        @foreach (var mesa in mesas)
                        {
                            var status = (mesa.Status ?? "").Trim();
                            var classeStatus = status.ToLowerInvariant() switch
                            {
                                "livre" => "status-livre",
                                "reservada" => "status-reservada",
                                "ocupada" => "status-ocupada",
                                _ => "status-outro"
                            };
                            var ambienteNome = string.IsNullOrWhiteSpace(mesa.AmbienteNome) ? "Não informado" : mesa.AmbienteNome.Trim();

                            <article class="mesa-card"
                                     data-ambiente="@ambienteNome"
                                     data-status="@status">
                                <div class="mesa-card-topo">
                                    <h2 class="mesa-card-numero">Mesa @mesa.Numero</h2>
                                    <span class="mesa-status @classeStatus">
                                        @(string.IsNullOrWhiteSpace(status) ? "Não informado" : status)
                                    </span>
                                </div>

                                <dl class="mesa-card-dados">
                                    <div>
                                        <dt>Ambiente</dt>
                                        <dd>@ambienteNome</dd>
                                    </div>
                                    <div>
                                        <dt>Capacidade</dt>
                                        <dd>@mesa.QtdLugares @(mesa.QtdLugares == 1 ? "lugar" : "lugares")</dd>
                                    </div>
                                </dl>

                                <div class="mesas-acoes">
                                    <a asp-action="Details" asp-route-id="@mesa.Id" class="acao-detalhes">Detalhes</a>
                                    <a asp-action="Edit" asp-route-id="@mesa.Id" class="acao-editar">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@mesa.Id" class="acao-excluir">Excluir</a>
                                </div>
                            </article>
                        }
                    </div>

                    <p class="mesas-filtro-vazio" id="mesas-filtro-vazio" hidden>
                        Nenhuma mesa encontrada com esses filtros.
                    </p>
                }
            </div>

            <footer class="mesas-footer">
                Santa Massa - Painel de gerenciamento
            </footer>
        </section>
    </main>

    <script src="~/js/mesasPainel.js" asp-append-version="true"></script>
</body>
</html>
