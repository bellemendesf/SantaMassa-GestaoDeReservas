@* Tipo de dado (modelo) que esta view recebe do controller *@
@model Funcionario
@* View Edit de Funcionario: apresenta os campos do DER via model MVC.
   As alterações passam pelo controller e pela interface do repositório. *@
@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @* Título da aba *@
    <title>Edit - Funcionario</title>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/TemaClaro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MenuRestaurante.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ValidacaoFormularios.css" asp-append-version="true" />
</head>
@* Corpo da página *@
<body class="container py-4 tema-claro com-sidebar-restaurante">
@await Html.PartialAsync("_MenuRestaurante")

    @* Navegação *@
    <nav class="mb-4">
        @* Link *@
        <a href="/Cliente/Index">Clientes</a> |
        @* Link *@
        <a href="/Funcionario/Index">Funcionários</a>
    </nav>
    @* Título principal *@
    <h1>Editar Funcionario</h1>
    @* Resumo dos erros de validação *@
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @* Formulário *@
    <form action="/Funcionario/Edit/@Model.Id" method="POST" novalidate data-validacao-form>
        @* Token antifalsificação do formulário *@
        @Html.AntiForgeryToken()
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="Nome" class="form-label">Nome</label>
            @* Campo de entrada (id Nome) *@
            <input id="Nome" name="Nome" type="text" value="@Model.Nome" class="form-control" maxlength="50" data-valida="nome" title="Informe o nome com pelo menos 3 letras, sem números ou símbolos." required>
            <span id="Nome-erro" class="erro-campo" data-erro-para="Nome" hidden></span>
        </div>
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="Cpf" class="form-label">CPF</label>
            @* Campo de entrada (id Cpf) *@
            <input id="Cpf" name="Cpf" type="text" value="@Model.Cpf" class="form-control" inputmode="numeric" maxlength="14" data-valida="cpf" title="Informe um CPF com 11 dígitos, com ou sem pontuação (000.000.000-00)." required>
            <span id="Cpf-erro" class="erro-campo" data-erro-para="Cpf" hidden></span>
        </div>
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="EmailPessoal" class="form-label">E-mail pessoal</label>
            @* Campo de entrada (id EmailPessoal) *@
            <input id="EmailPessoal" name="EmailPessoal" type="email" value="@Model.EmailInstitucional" class="form-control" required>
        </div>
        @* Bloco (classe mb-3) *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="EmailInstitucional" class="form-label">E-mail institucional</label>
            @* Campo de entrada (id EmailInstitucional) *@
            <input id="EmailInstitucional"
                   name="EmailInstitucional"
                   type="email"
                   value="@Model.EmailInstitucional"
                   class="form-control"
                   placeholder="nome@@santamassa.com.br"
                   data-valida="email-institucional"
                   data-email-original="@(ViewBag.EmailInstitucionalOriginal ?? Model.EmailInstitucional)"
                   pattern="(?!.*@@.*\.\.)[^\s]+@@santamassa[^\s]*"
                   title="O email do funcionário deve terminar em @@santamassa.com.br (ex.: nome@@santamassa.com.br)."
                   required>
            <small>Para alterar o e-mail, use um endereço terminando em @@santamassa.com.br (um ponto antes do .com). O e-mail atual pode ser mantido.</small>
            <span id="EmailInstitucional-erro" class="erro-campo" data-erro-para="EmailInstitucional" hidden></span>
        </div>
        @* Nunca preenchemos a senha com o valor armazenado pelo controller. *@
        <div class="mb-3">
            @* Rótulo do campo *@
            <label for="Senha" class="form-label">Senha (deixe em branco para manter a atual)</label>
            @* Campo de entrada (id Senha) *@
            <input id="Senha" name="Senha" type="password" autocomplete="new-password" class="form-control" >
        </div>
        @* Botão *@
        <button type="submit" class="btn btn-primary">Salvar</button>
        @* Link *@
        <a href="/Funcionario/Index" class="btn btn-secondary">Voltar</a>
    </form>
    <script src="~/js/validacaoFormularios.js" asp-append-version="true"></script>
</body>
</html>