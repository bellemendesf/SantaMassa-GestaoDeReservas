
@* Tipo de dado (modelo) que esta view recebe do controller *@
@model Funcionario

@* Bloco C#: configurações da view (título, layout e variáveis) *@
@{
    // Atribui Layout
    Layout = null;
    ViewData["Title"] = "Cadastrar funcionário";
    // Esta tela hoje exige login de funcionário (FuncionarioScheme no controller).
    // Se no futuro o cadastro for aberto sem login, Cancelar/Voltar vão para o login — não para a listagem.
    var funcionarioLogado = User?.Identities?.Any(i =>
        i.IsAuthenticated && i.AuthenticationType == "FuncionarioScheme") == true;
    var destinoController = funcionarioLogado ? "Funcionario" : "Auth";
    var destinoAction = funcionarioLogado ? "Index" : "Login";
    var textoVoltar = funcionarioLogado ? "← Voltar aos funcionários" : "← Voltar ao login";
}

@* Tipo do documento (HTML5) *@
<!DOCTYPE html>
@* Início do documento HTML *@
<html lang="pt-BR">
@* Cabeçalho do documento (título, fontes e estilos) *@
<head>
    @* Configuração da página *@
    <meta charset="UTF-8">
    @* Configuração da página *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    @* Título da aba *@
    <title>@ViewData["Title"]</title>

    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    @* Arquivo de estilo/fonte externo *@
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Arquivo de estilo/fonte externo *@
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;600;700&family=Poppins:wght@400;500;600&display=swap"
          rel="stylesheet">

    @* Arquivo de estilo/fonte externo *@
    <link rel="stylesheet" href="~/css/Cadastro.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/TemaClaro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MenuRestaurante.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ValidacaoFormularios.css" asp-append-version="true" />
</head>

@* Corpo da página *@
<body class="cadastro-page tema-claro com-sidebar-restaurante">
@await Html.PartialAsync("_MenuRestaurante")

    @* Conteúdo principal *@
    <main class="cadastro-container">

        @* Link *@
        <a class="cadastro-voltar-topo"
           asp-controller="@destinoController"
           asp-action="@destinoAction">
            @textoVoltar
        </a>

        @* Seção da página *@
        <section class="cadastro-card">

            @* Cabeçalho *@
            <header class="cadastro-header">
                @* Imagem *@
                <img src="~/images/logosantamassa.jpg"
                     alt="Santa Massa"
                     class="cadastro-logo">

                @* Parágrafo de texto *@
                <p class="cadastro-subtitulo">SANTA MASSA · EQUIPE</p>

                @* Título principal *@
                <h1>Novo funcionário</h1>

                @* Parágrafo de texto *@
                <p class="cadastro-descricao">
                    Preencha os dados do funcionário para realizar o cadastro.
                </p>
            </header>

            @* Resumo dos erros de validação *@
            @Html.ValidationSummary(false, "", new { @class = "cadastro-erros" })

            @* Formulário *@
            <form asp-controller="Funcionario"
                  asp-action="Create"
                  method="post"
                  class="cadastro-form" novalidate data-validacao-form>

                @* Token antifalsificação do formulário *@
                @Html.AntiForgeryToken()

                @* Bloco (classe campo-cadastro) *@
                <div class="campo-cadastro">
                    @* Rótulo do campo *@
                    <label for="Nome">Nome completo</label>
                    @* Campo de entrada (id Nome) *@
                    <input id="Nome"
                           name="Nome"
                           type="text"
                           value="@Model?.Nome"
                           placeholder="Nome completo"
                           autocomplete="name"
                           maxlength="50"
                           data-valida="nome"
                           title="Informe o nome com pelo menos 3 letras, sem números ou símbolos."
                           required>
                    <span id="Nome-erro" class="erro-campo" data-erro-para="Nome" hidden></span>
                </div>

                @* Bloco (classe campo-cadastro) *@
                <div class="campo-cadastro">
                    @* Rótulo do campo *@
                    <label for="Cpf">CPF</label>
                    @* Campo de entrada (id Cpf) *@
                    <input id="Cpf"
                           name="Cpf"
                           type="text"
                           value="@Model?.Cpf"
                           placeholder="000.000.000-00"
                           autocomplete="off"
                           inputmode="numeric"
                           maxlength="14"
                           data-valida="cpf"
                           title="Informe um CPF com 11 dígitos, com ou sem pontuação (000.000.000-00)."
                           required>
                    <span id="Cpf-erro" class="erro-campo" data-erro-para="Cpf" hidden></span>
                </div>

                @* Bloco (classe campo-cadastro) *@
                <div class="campo-cadastro">
                    @* Rótulo do campo *@
                    <label for="EmailInstitucional">E-mail institucional</label>
                    @* Campo de entrada (id EmailInstitucional) *@
                    <input id="EmailInstitucional"
                           name="EmailInstitucional"
                           type="email"
                           value="@Model?.EmailInstitucional"
                           placeholder="nome@@santamassa.com.br"
                           autocomplete="email"
                           maxlength="50"
                           data-valida="email-institucional"
                           pattern="(?!.*@@.*\.\.)[^\s]+@@santamassa\.com\.br"
                           title="O email do funcionário deve terminar em @@santamassa.com.br (ex.: nome@@santamassa.com.br)."
                           required>
                    <small class="cadastro-aviso-campo">O e-mail deve terminar em @@santamassa.com.br (um ponto antes do .com)</small>
                    <span id="EmailInstitucional-erro" class="erro-campo" data-erro-para="EmailInstitucional" hidden></span>
                </div>

                @* Bloco (classe campo-cadastro) *@
                <div class="campo-cadastro">
                    @* Rótulo do campo *@
                    <label for="Senha">Senha</label>
                    @* Campo de entrada (id Senha) *@
                    <input id="Senha"
                           name="Senha"
                           type="password"
                           placeholder="Crie uma senha"
                           autocomplete="new-password"
                           required>
                </div>

                @* Bloco (classe cadastro-botoes) *@
                <div class="cadastro-botoes">
                    @* Botão *@
                    <button type="submit" class="btn-cadastro-salvar">
                        Cadastrar funcionário
                    </button>

                    @* Link *@
                    <a asp-controller="@destinoController"
                       asp-action="@destinoAction"
                       class="btn-cadastro-voltar">
                        Cancelar
                    </a>
                </div>

            </form>
        </section>

        @* Rodapé *@
        <footer class="cadastro-rodape">
            Santa Massa · Rio Preto
        </footer>

    </main>
    <script src="~/js/validacaoFormularios.js" asp-append-version="true"></script>
</body>
</html>
